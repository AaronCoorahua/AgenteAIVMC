# VMC-Bot — copiar a .env y rellenar valores
# No subir .env a git

# Firecrawl (Centro de Ayuda + inventario)
FIRECRAWL_API_KEY=

# Pinecone (vector DB para RAG)
PINECONE_API_KEY=
PINECONE_INDEX_NAME=vmc-bot-rag

# Claude (router + respuestas)
ANTHROPIC_API_KEY=

# WhatsApp / servidor
PORT=8000
# DEBUG_MODE=true   # solo local: activa campo debug en POST /api/ask (interfaz debug)
WEBHOOK_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Intercom (Escalación de soporte)
INTERCOM_ACCESS_TOKEN=

# HERALD Feed API (catálogo de lotes + mercado AVT). Sin esto, stock_search usa inventario JSON local.
# Obtén el JWT desde el dashboard HERALD; no lo subas al repo. Rótalo si se expone por error.
HERALD_BASE_URL=https://feed.vmcsubastas.com
HERALD_API_TOKEN=

# Opcional: STT/TTS, inventario
# GOOGLE_API_KEY=   # Gemini 2.5 Flash STT
# ELEVENLABS_API_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
AUTO_MAINTENANCE=false
